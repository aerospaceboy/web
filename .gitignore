# Browser profiles contain cache, cookies, and local session state.
.cdp-profile*/

# Downloaded scratch files and local temporary output.
.tmp-*
*.tmp
*.log
__pycache__/
*.py[cod]
.venv/
venv/
.cache/
build/
reports/
backups/

# Local credentials and environment files.
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating system files.
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
